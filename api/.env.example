RAILS_ENV=development
RAILS_MAX_THREADS=5

# PostgreSQL 连接
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12

# 上传文件（头像）对外可访问的地址前缀，用于拼接存库的绝对 URL
PUBLIC_API_ORIGIN=http://localhost:3000

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173
